{
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make clean)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint run *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-go.sh"
          }
        ]
      }
    ]
  }
}
